import { LineEdit, CheckBox, Switch, ListView, ScrollView, ComboBox } from "std-widgets.slint";

// 嵌入中文静态字体（Android 上系统 CJK 字体回退不可靠；Noto，OFL 授权）
import "../fonts/NotoSansCJKsc-Regular.otf";
import "../fonts/NotoSansCJKsc-Bold.otf";

// 收到的提醒消息（Rust 侧填充）
export struct Msg {
    title: string,
    body: string,
    from: string,
    time: string,
    actions: string,
}

// Rust ↔ UI 的双向桥
export global AppBridge {
    // 连接状态
    in-out property <string> conn-status: "未连接";
    in-out property <bool> connected: false;
    in-out property <bool> alert-flash: false;
    in-out property <[Msg]> messages;

    // 连接设置（与输入框双向绑定）
    in-out property <string> broker: "broker.emqx.io";
    in-out property <string> port: "1883";
    in-out property <string> topic: "alertapp/demo/alerts";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <bool> use-tls: false;
    in-out property <bool> keep-alive: true;

    // 本机允许的提醒方式（过滤开关）
    in-out property <bool> act-popup: true;
    in-out property <bool> act-screen: true;
    in-out property <bool> act-vibrate: true;
    in-out property <bool> act-ring: true;

    // 提醒铃声：0=系统通知音（短促）1=系统闹钟音 2=系统来电铃
    in-out property <int> ringtone-index: 0;
    // 响铃时长：0=响一声 1=3秒 2=8秒 3=15秒 4=30秒
    in-out property <int> ring-mode-index: 0;
    callback preview-ringtone();

    // 电池白名单状态（true = 已加入，按钮显示 ✓ 且不再弹窗）
    in-out property <bool> battery-ok: false;
    callback settings-opened();

    // 发布页
    in-out property <string> pub-title;
    in-out property <string> pub-body;
    in-out property <bool> pub-popup: true;
    in-out property <bool> pub-screen: true;
    in-out property <bool> pub-vibrate: true;
    in-out property <bool> pub-ring: true;

    callback publish();
    callback save-settings();
    callback test-alert();
    callback open-battery();
    callback open-notif();
    callback clear-messages();
}

// ── 通用组件 ─────────────────────────────────────────────────────

// 渐变主按钮
component PrimaryButton inherits Rectangle {
    in property <string> label;
    callback clicked;
    property <bool> pressed: touch.pressed;
    min-height: 44px;
    border-radius: 12px;
    background: root.pressed ? #4338ca : @linear-gradient(135deg, #3b82f6, #4f46e5);
    animate background { duration: 90ms; }
    drop-shadow-color: #4f46e53d;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 幽灵按钮（白底描边）：宽度始终包住文字，避免被布局压窄导致文字出界
component GhostButton inherits Rectangle {
    in property <string> label;
    callback clicked;
    property <bool> pressed: touch.pressed;
    min-height: 40px;
    min-width: t.preferred-width + 28px;
    border-radius: 11px;
    background: root.pressed ? #eef2f8 : #ffffff;
    border-width: 1px;
    border-color: #dfe6ef;
    animate background { duration: 90ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    t := Text {
        text: root.label;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 底部导航的单个页签（原生图元线性图标，不依赖字体符号）
component TabItem inherits Rectangle {
    in property <int> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked;
    property <color> ic: root.active ? #2563eb : #94a3b8;
    background: transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding-top: 9px;
        padding-bottom: 7px;
        spacing: 3px;
        Rectangle {
            height: 24px;
            // 图标统一画在居中的 24×24 盒子里，保证与文字对齐
            box := Rectangle {
                x: (parent.width - 24px) / 2;
                y: 0;
                width: 24px;
                height: 24px;
                // 图标 0：对话气泡 + 三个点
                if root.icon == 0: Rectangle {
                    x: 2px; y: 4px; width: 20px; height: 14px;
                    border-radius: 6px;
                    border-width: 1.8px;
                    border-color: ic;
                    background: transparent;
                }
                if root.icon == 0: Rectangle { x: 7.2px; y: 9.8px; width: 2.4px; height: 2.4px; border-radius: 2px; background: ic; }
                if root.icon == 0: Rectangle { x: 10.8px; y: 9.8px; width: 2.4px; height: 2.4px; border-radius: 2px; background: ic; }
                if root.icon == 0: Rectangle { x: 14.4px; y: 9.8px; width: 2.4px; height: 2.4px; border-radius: 2px; background: ic; }
                // 图标 1：方框 + 加号（写消息）
                if root.icon == 1: Rectangle {
                    x: 3px; y: 3px; width: 18px; height: 18px;
                    border-radius: 5px;
                    border-width: 1.8px;
                    border-color: ic;
                    background: transparent;
                }
                if root.icon == 1: Rectangle { x: 8.1px; y: 11.1px; width: 7.8px; height: 1.8px; border-radius: 1px; background: ic; }
                if root.icon == 1: Rectangle { x: 11.1px; y: 8.1px; width: 1.8px; height: 7.8px; border-radius: 1px; background: ic; }
                // 图标 2：设置滑块
                if root.icon == 2: Rectangle { x: 4px; y: 5px; width: 16px; height: 1.8px; border-radius: 1px; background: ic; }
                if root.icon == 2: Rectangle { x: 4px; y: 11.1px; width: 16px; height: 1.8px; border-radius: 1px; background: ic; }
                if root.icon == 2: Rectangle { x: 4px; y: 17.2px; width: 16px; height: 1.8px; border-radius: 1px; background: ic; }
                if root.icon == 2: Rectangle { x: 14px; y: 3.4px; width: 5px; height: 5px; border-radius: 3px; background: ic; }
                if root.icon == 2: Rectangle { x: 5px; y: 9.5px; width: 5px; height: 5px; border-radius: 3px; background: ic; }
                if root.icon == 2: Rectangle { x: 11px; y: 15.6px; width: 5px; height: 5px; border-radius: 3px; background: ic; }
            }
        }
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.active ? 700 : 500;
            color: root.active ? #2563eb : #94a3b8;
            animate color { duration: 150ms; }
            horizontal-alignment: center;
        }
    }
}

// 设置页的小字段标签
component FieldLabel inherits Text {
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
}

// 白色圆角卡片（柔和阴影）
component Card inherits Rectangle {
    border-radius: 14px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e8edf4;
    drop-shadow-color: #3b4c6b14;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
}

export component AppWindow inherits Window {
    title: "即时提醒 AlertApp";
    preferred-width: 420px;
    preferred-height: 800px;
    // 闪烁时整个窗口（含状态栏区域）变红
    background: AppBridge.alert-flash ? #dc2626 : #eef1f6;
    animate background { duration: 200ms; }
    default-font-family: "Noto Sans CJK SC";

    property <int> current-tab: 0;

    // 消息详情弹窗
    property <bool> detail-open: false;
    property <string> detail-title;
    property <string> detail-body;
    property <string> detail-from;
    property <string> detail-time;
    property <string> detail-actions;

    // 整个界面按系统安全区内缩（状态栏/手势条/刘海），learn 同款做法
    Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;

        VerticalLayout {
        // ── 顶部：品牌 + 状态胶囊（收到提醒时整条变红）──────────
        Rectangle {
            height: 62px;
            background: AppBridge.alert-flash ? #dc2626 : #eef1f6;
            animate background { duration: 200ms; }
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;
                Text {
                    text: "即时提醒";
                    color: AppBridge.alert-flash ? #ffffff : #0f172a;
                    animate color { duration: 200ms; }
                    font-size: 19px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                // 状态胶囊（垂直居中，与标题同一水平线）
                Rectangle {
                    border-radius: 999px;
                    width: min(st.preferred-width + 30px, 210px);
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    background: AppBridge.connected ? #dcfce7 : #fee2e2;
                    animate background { duration: 200ms; }
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        spacing: 6px;
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - 8px) / 2;
                            border-radius: 4px;
                            background: AppBridge.connected ? #16a34a : #dc2626;
                        }
                        st := Text {
                            text: AppBridge.conn-status;
                            color: AppBridge.connected ? #15803d : #b91c1c;
                            font-size: 11px;
                            font-weight: 600;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── 页面一：消息 ────────────────────────────────────────
        if root.current-tab == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                // 清空入口：有消息时才显示
                if AppBridge.messages.length > 0: HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton {
                        label: "清空消息记录";
                        clicked => { AppBridge.clear-messages(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    ListView {
                        for m in AppBridge.messages: Rectangle {
                            width: parent.width;
                            height: msg-card.preferred-height + 10px;
                            msg-card := Card {
                                y: 0;
                                width: parent.width;
                                height: self.preferred-height;
                                touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.detail-title = m.title;
                                        root.detail-body = m.body;
                                        root.detail-from = m.from;
                                        root.detail-time = m.time;
                                        root.detail-actions = m.actions;
                                        root.detail-open = true;
                                    }
                                }
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            y: (parent.height - 8px) / 2;
                                            border-radius: 4px;
                                            background: #f97316;
                                        }
                                        Text {
                                            text: m.title;
                                            color: #0f172a;
                                            font-size: 15px;
                                            font-weight: 700;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: m.time;
                                            color: #94a3b8;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: m.body;
                                        color: #475569;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: m.from + " · " + m.actions + " · 点击查看全文";
                                        color: #94a3b8;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                    // 空状态提示
                    Text {
                        text: "还没有消息\n\n让其他设备给你发一条提醒试试";
                        color: #94a3b8;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        y: (parent.height - self.height) / 2;
                        height: 120px;
                        visible: AppBridge.messages.length == 0;
                    }
                }
            }
        }

        // ── 页面二：发布 ────────────────────────────────────────
        if root.current-tab == 1: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "发送一条提醒";
                            color: #0f172a;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: "所有订阅该主题的设备都会实时收到";
                            color: #94a3b8;
                            font-size: 12px;
                        }
                        Rectangle { height: 6px; }
                        FieldLabel { text: "标题"; }
                        LineEdit { text <=> AppBridge.pub-title; placeholder-text: "例如：服务器告警"; }
                        FieldLabel { text: "内容"; }
                        LineEdit { text <=> AppBridge.pub-body; placeholder-text: "例如：CPU 使用率 95%"; }
                        Rectangle { height: 4px; }
                        FieldLabel { text: "对方收到的提醒方式"; }
                        HorizontalLayout {
                            spacing: 6px;
                            CheckBox { text: "弹窗"; checked <=> AppBridge.pub-popup; }
                            CheckBox { text: "亮屏"; checked <=> AppBridge.pub-screen; }
                            CheckBox { text: "震动"; checked <=> AppBridge.pub-vibrate; }
                            CheckBox { text: "响铃"; checked <=> AppBridge.pub-ring; }
                        }
                        // 弹性空隙：把发布按钮压到卡片底部
                        Rectangle { vertical-stretch: 1; }
                        PrimaryButton {
                            label: "发布提醒";
                            clicked => { AppBridge.publish(); }
                        }
                        Text {
                            text: "将发布到 " + AppBridge.topic;
                            color: #94a3b8;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // ── 页面三：设置 ────────────────────────────────────────
        if root.current-tab == 2: Rectangle {
            vertical-stretch: 1;
            ScrollView {
                // 锁定内容宽度 = 视口宽度（避免输入框把内容撑出屏幕）
                viewport-width: parent.width;
                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: "连接";
                                color: #0f172a;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            FieldLabel { text: "MQTT 服务器"; }
                            LineEdit { text <=> AppBridge.broker; }
                            FieldLabel { text: "端口"; }
                            LineEdit { text <=> AppBridge.port; input-type: number; }
                            FieldLabel { text: "主题 Topic（订阅与发布共用）"; }
                            LineEdit { text <=> AppBridge.topic; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: "账号（可留空）";
                                color: #0f172a;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            FieldLabel { text: "用户名"; }
                            LineEdit { text <=> AppBridge.username; }
                            FieldLabel { text: "密码"; }
                            LineEdit { text <=> AppBridge.password; input-type: InputType.password; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "选项";
                                color: #0f172a;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Switch { checked <=> AppBridge.use-tls; }
                                Text {
                                    text: "TLS 加密（公网请用 8883 端口）";
                                    color: #334155;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Switch { checked <=> AppBridge.keep-alive; }
                                Text {
                                    text: "后台保活（持有唤醒锁，息屏保持连接）";
                                    color: #334155;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: "提醒方式";
                                color: #0f172a;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "收到提醒时本机执行哪些动作；与发送方请求取交集，关掉的方式绝不打扰";
                                color: #94a3b8;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            GridLayout {
                                spacing: 6px;
                                Row {
                                    CheckBox { text: "弹窗"; checked <=> AppBridge.act-popup; }
                                    CheckBox { text: "亮屏"; checked <=> AppBridge.act-screen; }
                                }
                                Row {
                                    CheckBox { text: "震动"; checked <=> AppBridge.act-vibrate; }
                                    CheckBox { text: "响铃"; checked <=> AppBridge.act-ring; }
                                }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: "提醒铃声";
                                color: #0f172a;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            ComboBox {
                                model: ["系统通知音（短促）", "系统闹钟音", "系统来电铃"];
                                current-index <=> AppBridge.ringtone-index;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "响铃时长";
                                    color: #64748b;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 56px;
                                }
                                ComboBox {
                                    model: ["响一声", "3 秒", "8 秒", "15 秒", "30 秒"];
                                    current-index <=> AppBridge.ring-mode-index;
                                    horizontal-stretch: 1;
                                }
                                GhostButton {
                                    label: "试听";
                                    clicked => { AppBridge.preview-ringtone(); }
                                }
                            }
                        }
                    }
                    PrimaryButton {
                        label: "保存并重连";
                        clicked => { AppBridge.save-settings(); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        GhostButton {
                            label: "测试提醒";
                            clicked => { AppBridge.test-alert(); }
                        }
                        GhostButton {
                            label: AppBridge.battery-ok ? "电池白名单 ✓" : "电池白名单";
                            clicked => { AppBridge.open-battery(); }
                        }
                        GhostButton { label: "通知设置"; clicked => { AppBridge.open-notif(); } }
                    }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            Text {
                                text: "小贴士";
                                color: #0f172a;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "手机端请点「电池白名单」，并在系统设置里允许自启动、在最近任务中锁定本应用（小米/华为等 ROM 需要），息屏时才能实时收到提醒。";
                                color: #64748b;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // ── 底部导航（现代移动端布局，自动避开手势条）────────────
        Rectangle {
            height: 64px;
            background: #ffffff;
            Rectangle { y: 0; height: 1px; background: #e8edf4; }
            HorizontalLayout {
                TabItem {
                    icon: 0;
                    label: "消息";
                    active: root.current-tab == 0;
                    clicked => { root.current-tab = 0; }
                }
                TabItem {
                    icon: 1;
                    label: "发布";
                    active: root.current-tab == 1;
                    clicked => { root.current-tab = 1; }
                }
                TabItem {
                    icon: 2;
                    label: "设置";
                    active: root.current-tab == 2;
                    clicked => {
                        root.current-tab = 2;
                        AppBridge.settings-opened();
                    }
                }
            }
        }
        }

        // ── 消息详情弹窗（点卡片打开，点背景/按钮关闭）────────────
        if root.detail-open: Rectangle {
            width: root.width;
            height: root.height;
            background: #00000073;
            animate background { duration: 120ms; }
            TouchArea {
                clicked => { root.detail-open = false; }
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width - 40px;
                height: min(detail-box.preferred-height, parent.height - 48px);
                detail-box := VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: root.detail-title;
                        color: #0f172a;
                        font-size: 17px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.detail-time + " · " + root.detail-from + " · " + root.detail-actions;
                        color: #94a3b8;
                        font-size: 11px;
                    }
                    Rectangle { height: 1px; background: #eef1f6; }
                    ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.width - 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.detail-body;
                                color: #1f2937;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    PrimaryButton {
                        label: "关闭";
                        clicked => { root.detail-open = false; }
                    }
                }
            }
        }
    }
}
